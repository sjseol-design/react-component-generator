{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.npmrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/.npmrc)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*credential*)",
      "Write(**/*secret*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(cp *.env* *)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/pre-commit-test.ts",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/tdd-reminder.ts"
          }
        ]
      }
    ]
  }
}
